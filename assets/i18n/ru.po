msgid "Locked chats code"
msgstr "Код для заблокированных чатов"

#: src/ui/settings.rs:371
msgid ""
"Opens the Locked tab on this computer. It hides chats, it does not encrypt "
"them."
msgstr ""
"Открывает вкладку «Заблокированные» на этом компьютере. Он скрывает чаты, но "
"не шифрует их."

#: src/ui/settings.rs:383
msgid "Secret code"
msgstr "Секретный код"

#: src/ui/settings.rs:392
msgid "Clear"
msgstr "Очистить"

